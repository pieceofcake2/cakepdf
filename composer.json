{
    "name": "pieceofcake2/cakepdf",
    "description": "CakePHP 2 plugin for converting HTML to PDF with Dompdf, mPDF, TCPDF or wkhtmltopdf",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "pdf"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "dompdf/dompdf": "^3.1",
        "mpdf/mpdf": "^8.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpcs-cakephp2": "^1.1",
        "pieceofcake2/phpstan-cakephp2": "^1.0",
        "tecnickcom/tcpdf": "^6.10"
    },
    "suggest": {
        "dompdf/dompdf": "When using DomPDF as engine."
    },
    "replace": {
        "ceeram/cakepdf": "^1.0",
        "friendsofcake/cakepdf": "^1.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "CakePdf"
    }
}
